#!/bin/sh
# Keyboard teleop for the TurtleBot, the ROS 2 equivalent of ROS 1's
# `roslaunch turtlebot_teleop keyboard_teleop.launch`:
#
#   ros2 run turtlebot_teleop keyboard_teleop
#
# Runs teleop_twist_keyboard into cmd_vel_mux's input/teleop (so it overrides
# navigation but not the safety controller), starting at a gentle 0.2 m/s and
# 1.0 rad/s; use q/z (both), w/x (linear) and e/c (angular) to change speed.
# Extra ROS arguments are passed through, e.g.
#
#   ros2 run turtlebot_teleop keyboard_teleop -p speed:=0.4
#
# This is a `ros2 run` executable rather than a launch file because
# teleop_twist_keyboard reads keys from its terminal, and `ros2 launch` does
# not give the nodes it starts a terminal (it fails with
# "termios.error: (25, 'Inappropriate ioctl for device')").
exec ros2 run teleop_twist_keyboard teleop_twist_keyboard --ros-args \
    -r cmd_vel:=/input/teleop \
    -p speed:=0.2 \
    -p turn:=1.0 \
    "$@"
